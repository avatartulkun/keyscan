<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btn_trash_back" android:layout_width="44dp" android:layout_height="42dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_arrow_back_24" android:padding="8dp" android:contentDescription="@string/trash_back_description" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:text="@string/trash_title" android:textColor="@color/text_main"
                android:textSize="27sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/card_trash_retention" style="@style/BackupCard" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trash_retention_title"
                android:textColor="@color/text_main" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_trash_retention" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/trash_batch_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <CheckBox android:id="@+id/cb_trash_select_all" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="@string/trash_select_all" android:textColor="@color/text_main" />
                <Button android:id="@+id/btn_trash_clear" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/trash_clear" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btn_trash_restore_selected" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:enabled="false" android:text="@string/trash_action_restore_selected" />
                <Button android:id="@+id/btn_trash_delete_selected" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:layout_weight="1" android:enabled="false" android:text="@string/trash_action_delete_selected_permanently" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tv_trash_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="36dp" android:text="@string/trash_empty" android:textColor="@color/text_secondary" />
        <LinearLayout android:id="@+id/list_trash" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
