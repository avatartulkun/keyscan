<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/iv_password_group_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_password_group_custom_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_password_group_custom" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_password_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_password_group_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_password_group_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:minWidth="38dp"
        android:textColor="@color/text_main"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/tv_password_group_arrow"
        android:layout_width="30dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_down_24"
        android:tint="@color/action_icon_tint" />

    <ImageButton
        android:id="@+id/btn_password_group_more"
        android:layout_width="34dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/a11y_more"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vertical"
        android:tint="@color/action_icon_tint" />
</LinearLayout>
