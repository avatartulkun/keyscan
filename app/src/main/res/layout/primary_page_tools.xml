<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/primary_page_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="24dp">
        <TextView style="@style/PrimarySectionTitle" android:text="@string/primary_tools" />

        <LinearLayout android:id="@+id/primary_tool_scan" style="@style/PrimaryEntryCard" android:background="@drawable/bg_primary_tool_scan">
            <ImageView android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_primary_icon_blue" android:elevation="5dp" android:padding="13dp" android:src="@drawable/ic_scan" android:tint="@android:color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_scan" android:textColor="@color/primary_reference_title" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:text="@string/primary_tool_scan_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

        <LinearLayout android:id="@+id/primary_tool_share" style="@style/PrimaryEntryCard" android:background="@drawable/bg_primary_tool_share">
            <ImageView android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_primary_icon_teal" android:elevation="5dp" android:padding="14dp" android:src="@drawable/ic_primary_share" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_generate" android:textColor="@color/primary_reference_title" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:text="@string/primary_tool_share_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

        <LinearLayout android:id="@+id/primary_tool_password_generator" style="@style/PrimaryEntryCard" android:background="@drawable/bg_primary_tool_password">
            <ImageView android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_primary_icon_purple" android:elevation="5dp" android:padding="13dp" android:src="@drawable/ic_key_gear" android:tint="@android:color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_password_generator" android:textColor="@color/primary_reference_title" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:text="@string/primary_tool_password_summary" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
