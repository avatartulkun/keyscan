<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_page_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:background="@color/surface_light"
        android:paddingEnd="8dp">

        <com.secureqr.scanner.ui.home.KeyScanBrandLockupView
            android:id="@+id/primary_brand_subtitle"
            android:layout_width="124dp"
            android:layout_height="54dp"
            android:layout_marginTop="-2dp"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/primary_action_cloud_sync"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/a11y_global_sync_webdav"
                android:padding="10dp"
                android:src="@drawable/ic_cloud_sync_24" />

            <ImageButton
                android:id="@+id/primary_action_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/primary_add"
                android:padding="10dp"
                android:src="@drawable/ic_add_24"
                android:tint="@color/settings_purple" />

            <ImageButton
                android:id="@+id/primary_action_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/more"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert_24"
                android:tint="@color/primary_reference_title" />
        </LinearLayout>
    </RelativeLayout>

    <com.secureqr.scanner.ui.home.PrimaryPageSwipeContainer
        android:id="@+id/primary_page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/primary_page_tools"
            layout="@layout/primary_page_tools" />

        <include
            android:id="@+id/primary_page_home"
            layout="@layout/primary_page_home" />

        <include
            android:id="@+id/primary_page_data"
            layout="@layout/primary_page_data" />
    </com.secureqr.scanner.ui.home.PrimaryPageSwipeContainer>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/primary_operation_lock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_operation_lock"
            android:contentDescription="@string/operation_lock_view_desc"
            android:padding="9dp"
            android:src="@drawable/ic_operation_lock_closed"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/primary_operation_mode_label"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="@string/operation_view_mode"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/primary_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_primary_bottom_nav"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/primary_nav_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:tag="icon" android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_primary_tools" />
            <TextView android:tag="label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/primary_tools" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/primary_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:tag="icon" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_primary_home" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/primary_page_dot_tools"
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/border_soft"
                    android:textSize="8sp" />
                <TextView
                    android:id="@+id/primary_page_dot_home"
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/accent"
                    android:textSize="8sp" />
                <TextView
                    android:id="@+id/primary_page_dot_data"
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/border_soft"
                    android:textSize="8sp" />
            </LinearLayout>
            <TextView android:tag="label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/primary_home" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/primary_nav_data"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:tag="icon" android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_primary_database" />
            <TextView android:tag="label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/primary_data" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
