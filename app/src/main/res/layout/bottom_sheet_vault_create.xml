<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_bottom_sheet" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
    <View android:layout_width="38dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="10dp" android:background="@drawable/bg_chip"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_sheet_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/vault_action_back_category" android:src="@drawable/ic_arrow_back_24" android:tint="@color/text_main" android:visibility="gone"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_sheet_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vault_create_title" android:textColor="@color/text_main" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_sheet_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/vault_create_choose_type" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btn_sheet_close" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/common_action_close" android:src="@drawable/ic_add_24" android:rotation="45" android:tint="@color/text_secondary"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_sheet_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="true"/>
</LinearLayout>
