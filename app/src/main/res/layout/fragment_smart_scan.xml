<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_light" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_smart_scan_home" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@drawable/ic_home_24" android:tint="@color/text_main" android:contentDescription="@string/vault_home"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/smart_scan_title" android:textColor="@color/text_main" android:textSize="21sp" android:textStyle="bold"/>
        <Space android:layout_width="44dp" android:layout_height="44dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/smart_scan_privacy_summary" android:textColor="@color/text_secondary" android:textSize="13sp"/>
    <LinearLayout android:id="@+id/card_scan_qr" style="@style/SmartScanCard" android:layout_marginTop="30dp"><ImageView style="@style/SmartScanIcon" android:background="@drawable/bg_tool_icon_cyan" android:src="@drawable/ic_qr" android:tint="@color/vault_icon_cyan"/><LinearLayout style="@style/SmartScanText"><TextView style="@style/SmartScanTitle" android:text="@string/smart_scan_qr_title"/><TextView style="@style/SmartScanSubtitle" android:text="@string/smart_scan_qr_summary"/></LinearLayout><TextView style="@style/SmartScanArrow"/></LinearLayout>
    <LinearLayout android:id="@+id/card_scan_otp" style="@style/SmartScanCard"><ImageView style="@style/SmartScanIcon" android:background="@drawable/bg_tool_icon_pink" android:src="@drawable/ic_shield" android:tint="@color/vault_icon_purple"/><LinearLayout style="@style/SmartScanText"><TextView style="@style/SmartScanTitle" android:text="@string/smart_scan_otp_title"/><TextView style="@style/SmartScanSubtitle" android:text="@string/smart_scan_otp_summary"/></LinearLayout><TextView style="@style/SmartScanArrow"/></LinearLayout>
    <LinearLayout android:id="@+id/card_scan_bank" style="@style/SmartScanCard"><ImageView style="@style/SmartScanIcon" android:background="@drawable/bg_tool_icon_orange" android:src="@drawable/ic_book_key" android:tint="@color/vault_icon_orange"/><LinearLayout style="@style/SmartScanText"><TextView style="@style/SmartScanTitle" android:text="@string/smart_scan_bank_title"/><TextView style="@style/SmartScanSubtitle" android:text="@string/smart_scan_bank_summary"/></LinearLayout><TextView style="@style/SmartScanArrow"/></LinearLayout>
    <LinearLayout android:id="@+id/card_scan_document" style="@style/SmartScanCard"><ImageView style="@style/SmartScanIcon" android:background="@drawable/bg_tool_icon_green" android:src="@drawable/ic_shield" android:tint="@color/vault_icon_green"/><LinearLayout style="@style/SmartScanText"><TextView style="@style/SmartScanTitle" android:text="@string/smart_scan_document_title"/><TextView style="@style/SmartScanSubtitle" android:text="@string/smart_scan_document_summary"/></LinearLayout><TextView style="@style/SmartScanArrow"/></LinearLayout>
    <LinearLayout android:id="@+id/card_scan_file" style="@style/SmartScanCard"><ImageView style="@style/SmartScanIcon" android:background="@drawable/bg_tool_icon_cyan" android:src="@drawable/ic_vault_contract" android:tint="@color/vault_icon_blue"/><LinearLayout style="@style/SmartScanText"><TextView style="@style/SmartScanTitle" android:text="@string/smart_scan_file_title"/><TextView style="@style/SmartScanSubtitle" android:text="@string/smart_scan_file_summary"/></LinearLayout><TextView style="@style/SmartScanArrow"/></LinearLayout>
</LinearLayout>
