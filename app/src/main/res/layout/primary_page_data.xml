<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/primary_page_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="24dp">
        <TextView style="@style/PrimarySectionTitle" android:text="@string/primary_data" />

        <LinearLayout android:id="@+id/primary_data_backup" style="@style/PrimaryEntryCard" android:layout_height="100dp" android:background="@drawable/bg_primary_data_backup" android:padding="14dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_icon_teal" android:elevation="4dp" android:padding="11dp" android:src="@drawable/ic_primary_backup" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_webdav" android:textColor="@color/primary_reference_title" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="@string/primary_backup_summary" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

        <LinearLayout android:id="@+id/primary_data_export" style="@style/PrimaryEntryCard" android:layout_height="100dp" android:background="@drawable/bg_primary_data_history" android:padding="14dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_icon_purple" android:elevation="4dp" android:padding="13dp" android:src="@drawable/ic_export" android:tint="@android:color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/export_data" android:textColor="@color/primary_reference_title" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="@string/primary_export_summary" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

        <LinearLayout android:id="@+id/primary_data_trash" style="@style/PrimaryEntryCard" android:layout_height="100dp" android:background="@drawable/bg_primary_data_trash" android:padding="14dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_icon_red" android:elevation="4dp" android:padding="13dp" android:src="@drawable/ic_delete_24" android:tint="@android:color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trash_title" android:textColor="@color/primary_reference_title" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="@string/trash_settings_summary" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

        <LinearLayout android:id="@+id/primary_data_history" style="@style/PrimaryEntryCard" android:layout_height="100dp" android:background="@drawable/bg_primary_data_history" android:padding="14dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_icon_purple" android:elevation="4dp" android:padding="12dp" android:src="@drawable/ic_history" android:tint="@android:color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_history" android:textColor="@color/primary_reference_title" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="@string/primary_history_summary" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
            <TextView style="@style/PrimaryEntryArrow" android:textColor="@color/primary_reference_title" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
