<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_otp_home"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:contentDescription="@string/otp_home_desc"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home_24"
            android:elevation="0dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:padding="8dp"
            android:text=""
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/home_otp"
            android:textColor="@color/text_main"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_otp_export"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/otp_action_more"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_24" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/otp_auth_desc"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <SearchView
        android:id="@+id/search_otp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edit_text"
        android:iconifiedByDefault="false"
        android:queryHint="@string/otp_search_hint" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_otp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>

