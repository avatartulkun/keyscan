<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btn_webdav_home" android:layout_width="44dp" android:layout_height="42dp"
                android:background="@android:color/transparent" android:scaleType="centerInside" android:src="@drawable/ic_home_24" android:elevation="0dp"
                android:gravity="center" android:minWidth="0dp" android:padding="8dp" android:text="" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:layout_weight="1" android:text="@string/webdav_title" android:textColor="@color/text_main"
                android:textSize="27sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. 数据保护密钥设置 -->
        <!-- 数据保护密钥由首次安全保险箱设置和安全中心统一管理。
             保留隐藏控件仅用于兼容现有备份流程，不再显示重复设置模块。 -->
        <LinearLayout android:id="@+id/card_backup_encryption" style="@style/BackupCard" android:visibility="gone">
            <LinearLayout android:id="@+id/row_backup_encryption_title" style="@style/BackupHeaderRow">
                <ImageView style="@style/BackupHeaderIcon" android:src="@drawable/ic_key_gear" />
                <LinearLayout style="@style/BackupHeaderTextBlock">
                    <TextView style="@style/BackupHeaderTitle" android:text="@string/backup_encryption_section_title" />
                    <TextView android:id="@+id/tv_backup_encryption_method" style="@style/BackupHeaderSummary" android:text="@string/backup_encryption_summary_ledger" />
                </LinearLayout>
                <TextView android:id="@+id/tv_backup_encryption_arrow" style="@style/BackupHeaderArrow" />
            </LinearLayout>
            <LinearLayout android:id="@+id/content_backup_encryption" style="@style/BackupContent">
                <RadioGroup android:id="@+id/rg_backup_encryption_mode" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rb_backup_encryption_ledger" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/backup_use_ledger_detail" />
                    <RadioButton android:id="@+id/rb_backup_encryption_custom" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/backup_use_custom_detail" />
                </RadioGroup>
                <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <EditText android:id="@+id/et_backup_encryption_password" android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text" android:hint="@string/independent_backup_password" android:inputType="textPassword"
                        android:paddingStart="12dp" android:paddingEnd="52dp" android:textColor="@color/text_main" />
                    <Button android:id="@+id/btn_toggle_backup_encryption_password" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical" android:minWidth="0dp" />
                </FrameLayout>
                <Button android:id="@+id/btn_change_backup_password" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/backup_save_key_settings" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text" android:padding="10dp" android:text="@string/backup_key_important_note"
                    android:textColor="@color/warning" android:textSize="12sp" />
                <Button android:id="@+id/btn_convert_main_legacy_backup" android:layout_width="match_parent" android:layout_height="40dp"
                    android:visibility="gone" android:text="@string/convert_legacy_backup" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. WebDAV配置：两个通道内部固定展开 -->
        <LinearLayout android:id="@+id/card_webdav_config" style="@style/BackupCard" android:background="@drawable/bg_backup_webdav_card">
            <LinearLayout android:id="@+id/row_webdav_config_title" style="@style/BackupHeaderRow">
                <ImageView style="@style/BackupHeaderIcon" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_backup_webdav_icon" android:padding="10dp" android:tint="@null" android:src="@drawable/ic_backup_webdav_add" />
                <LinearLayout style="@style/BackupHeaderTextBlock">
                    <TextView style="@style/BackupHeaderTitle" android:text="@string/webdav_config_title" />
                </LinearLayout>
                <ImageButton android:id="@+id/btn_webdav_help" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_backup_help_button" android:contentDescription="@string/help_title" android:padding="8dp" android:src="@drawable/ic_help_24" android:tint="@color/info" />
                <TextView android:id="@+id/tv_webdav_config_arrow" style="@style/BackupHeaderArrow" />
            </LinearLayout>
            <LinearLayout android:id="@+id/content_webdav_config" style="@style/BackupContent">
                <TextView style="@style/BackupSubTitle" android:text="WebDAV 1" />
                <EditText android:id="@+id/et_webdav_url" style="@style/BackupEdit" android:hint="@string/webdav_url_hint" android:inputType="textUri" />
                <EditText android:id="@+id/et_webdav_user" style="@style/BackupEdit" android:hint="@string/username_hint" android:inputType="text" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp">
                    <EditText android:id="@+id/et_webdav_pass" android:layout_width="match_parent" android:layout_height="42dp"
                        android:background="@drawable/bg_edit_text" android:hint="@string/webdav_password_hint" android:inputType="textPassword"
                        android:paddingStart="12dp" android:paddingEnd="52dp" android:textColor="@color/text_main" />
                    <Button android:id="@+id/btn_toggle_webdav_pass" android:layout_width="42dp" android:layout_height="42dp"
                        android:layout_gravity="end|center_vertical" android:minWidth="0dp" />
                </FrameLayout>
                <LinearLayout style="@style/BackupButtonRow">
                    <Button android:id="@+id/btn_test_main_webdav" style="@style/BackupHalfButton" android:text="@string/test_main_connection" />
                    <Button android:id="@+id/btn_save_webdav_settings" style="@style/BackupHalfButton" android:layout_marginStart="8dp" android:text="@string/save_webdav_settings" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:background="@color/card_stroke" />
                <TextView style="@style/BackupSubTitle" android:text="WebDAV 2" />
                <EditText android:id="@+id/et_webdav_backup_url" style="@style/BackupEdit" android:hint="@string/webdav_url_hint" android:inputType="textUri" />
                <EditText android:id="@+id/et_webdav_backup_user" style="@style/BackupEdit" android:hint="@string/username_hint" android:inputType="text" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp">
                    <EditText android:id="@+id/et_webdav_backup_pass" android:layout_width="match_parent" android:layout_height="42dp"
                        android:background="@drawable/bg_edit_text" android:hint="@string/webdav_password_hint" android:inputType="textPassword"
                        android:paddingStart="12dp" android:paddingEnd="52dp" android:textColor="@color/text_main" />
                    <Button android:id="@+id/btn_toggle_backup_webdav_pass" android:layout_width="42dp" android:layout_height="42dp"
                        android:layout_gravity="end|center_vertical" android:minWidth="0dp" />
                </FrameLayout>
                <LinearLayout style="@style/BackupButtonRow">
                    <Button android:id="@+id/btn_test_backup_webdav" style="@style/BackupHalfButton" android:text="@string/test_backup_connection" />
                    <Button android:id="@+id/btn_save_backup_webdav_settings" style="@style/BackupHalfButton" android:layout_marginStart="8dp" android:text="@string/save_webdav_settings" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. 备份设置 -->
        <LinearLayout android:id="@+id/card_sync_settings" style="@style/BackupCard" android:background="@drawable/bg_backup_online_card">
            <LinearLayout android:id="@+id/row_sync_settings_title" style="@style/BackupHeaderRow">
                <ImageView style="@style/BackupHeaderIcon" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_backup_online_icon" android:padding="10dp" android:tint="@null" android:src="@drawable/ic_backup_online_sync" />
                <LinearLayout style="@style/BackupHeaderTextBlock">
                    <TextView style="@style/BackupHeaderTitle" android:text="@string/online_backup_restore_title" />
                    <TextView android:id="@+id/tv_sync_settings_status" style="@style/BackupHeaderSummary" android:text="@string/backup_settings_default_status" />
                </LinearLayout>
                <TextView android:id="@+id/tv_sync_settings_arrow" style="@style/BackupHeaderArrow" />
            </LinearLayout>
            <LinearLayout android:id="@+id/content_sync_settings" style="@style/BackupContent">
                <CheckBox android:id="@+id/cb_auto_sync" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/auto_backup_when_changed" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_selection_title" android:textColor="@color/text_main" android:textStyle="bold" />
                <RadioGroup android:id="@+id/rg_sync_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/rb_sync_target_main" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="WebDAV 1" />
                    <RadioButton android:id="@+id/rb_sync_target_backup" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="WebDAV 2" />
                    <RadioButton android:id="@+id/rb_sync_target_all" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:checked="true" android:text="@string/common_all" />
                </RadioGroup>
                <Button android:id="@+id/btn_sync" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/backup_now" />
                <LinearLayout android:id="@+id/content_backup_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. 本地备份 -->
        <LinearLayout android:id="@+id/card_local_backup" style="@style/BackupCard" android:background="@drawable/bg_backup_local_card">
            <LinearLayout android:id="@+id/row_local_backup_title" style="@style/BackupHeaderRow">
                <ImageView style="@style/BackupHeaderIcon" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_backup_local_icon" android:padding="10dp" android:tint="@null" android:src="@drawable/ic_backup_local_download" />
                <LinearLayout style="@style/BackupHeaderTextBlock">
                    <TextView style="@style/BackupHeaderTitle" android:text="@string/local_backup_restore_title" />
                    <TextView android:id="@+id/tv_local_backup_status" style="@style/BackupHeaderSummary" android:text="@string/local_backup_empty_status" />
                </LinearLayout>
                <TextView android:id="@+id/tv_local_backup_arrow" style="@style/BackupHeaderArrow" />
            </LinearLayout>
            <LinearLayout android:id="@+id/content_local_backup" style="@style/BackupContent">
                <CheckBox android:id="@+id/cb_local_auto_backup" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/local_auto_backup" />
                <TextView android:id="@+id/tv_local_backup_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_backup_location_unselected" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tv_local_backup_latest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/local_backup_none" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/btn_local_backup_select_location" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/local_backup_select_location" />
                <Button android:id="@+id/btn_local_backup_now" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/local_backup_create" />
                <Button android:id="@+id/btn_local_backup_restore" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/local_backup_restore" />
            </LinearLayout>
        </LinearLayout>

        <!-- 保留旧业务监听所需ID，不参与页面展示。 -->
        <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:orientation="vertical">
            <LinearLayout android:id="@+id/card_network_access" android:layout_width="1dp" android:layout_height="1dp"><LinearLayout android:id="@+id/row_network_access_title" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/tv_network_access_status" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/tv_network_access_arrow" android:layout_width="1dp" android:layout_height="1dp"/><LinearLayout android:id="@+id/content_network_access" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
            <Spinner android:id="@+id/sp_webdav_algorithm" android:layout_width="1dp" android:layout_height="1dp" />
            <Spinner android:id="@+id/sp_main_sync_content" android:layout_width="1dp" android:layout_height="1dp" />
            <Spinner android:id="@+id/sp_backup_sync_content" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/tv_last_sync" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/tv_backup_history" android:layout_width="1dp" android:layout_height="1dp" />
            <LinearLayout android:id="@+id/ll_cloud_backups" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_sync_main_webdav" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_sync_backup_webdav" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_restore_main_webdav" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_restore_backup_webdav" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_choose_backup_target" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_backup_history" android:layout_width="1dp" android:layout_height="1dp" />
            <LinearLayout android:id="@+id/card_backup_data" android:layout_width="1dp" android:layout_height="1dp"><LinearLayout android:id="@+id/row_backup_data_title" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/tv_backup_data_status" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/tv_backup_data_arrow" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
