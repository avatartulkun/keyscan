<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_appearance_home"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_settings_home"
                android:contentDescription="@string/home_shortcut_desc"
                android:elevation="0dp"
                android:padding="10dp"
                android:src="@drawable/ic_home_24"
                android:tint="@color/settings_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/text_main"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_card_blue"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/SettingsSectionHeader">
                <ImageView
                    style="@style/SettingsSectionIcon"
                    android:background="@drawable/bg_settings_icon_blue"
                    android:src="@drawable/ic_security_lock_24"
                    android:tint="@color/settings_blue" />
                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/security_privacy" />
            </LinearLayout>

            <TextView
                style="@style/SettingsFeatureLabel"
                android:layout_marginTop="16dp"
                android:text="@string/autofill_settings_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">
                <TextView
                    android:id="@+id/tv_autofill_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="@string/autofill_disabled"
                    android:textColor="@color/settings_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btn_autofill_open_settings"
                    style="@style/SettingsTextAction"
                    android:layout_marginStart="8dp"
                    android:text="@string/autofill_open_settings" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_autofill_guide"
                style="@style/SettingsActionButton"
                android:drawableStart="@drawable/ic_vault_file_lock"
                android:text="@string/autofill_guide_button" />

            <TextView
                android:id="@+id/tv_autofill_chrome_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/autofill_chrome_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_autofill_chrome_settings"
                style="@style/SettingsActionButton"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/autofill_open_chrome_settings" />

            <TextView
                style="@style/SettingsFeatureLabel"
                android:layout_marginTop="18dp"
                android:text="@string/operation_unlock_default" />

            <RadioGroup
                android:id="@+id/rg_operation_default_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_settings_status"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rb_operation_view"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/operation_view_mode"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rb_operation_edit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/operation_edit_mode"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />
            </RadioGroup>

            <Switch
                android:id="@+id/sw_operation_vibrate"
                style="@style/SettingsModernSwitch"
                android:text="@string/operation_feedback_vibrate" />

            <Switch
                android:id="@+id/sw_operation_message"
                style="@style/SettingsModernSwitch"
                android:text="@string/operation_feedback_message" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_status"
                android:padding="12dp"
                android:text="@string/operation_scope_summary"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card_purple"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/SettingsSectionHeader">
                <ImageView
                    style="@style/SettingsSectionIcon"
                    android:background="@drawable/bg_settings_icon_purple"
                    android:src="@drawable/ic_vault_mail_settings"
                    android:tint="@color/settings_purple" />
                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/notification_settings_title" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_notifications"
                style="@style/SettingsModernSwitch"
                android:layout_marginTop="12dp"
                android:text="@string/notification_enable" />

            <TextView
                android:id="@+id/tv_notification_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/notification_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_notification_settings"
                style="@style/SettingsActionButton"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/notification_system_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card_green"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/SettingsSectionHeader">
                <ImageView
                    style="@style/SettingsSectionIcon"
                    android:background="@drawable/bg_settings_icon_green"
                    android:src="@drawable/ic_scan"
                    android:tint="@color/settings_green" />
                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/scan_settings" />
            </LinearLayout>

            <Switch android:id="@+id/sw_scan_vibrate" style="@style/SettingsModernSwitch" android:layout_marginTop="12dp" android:text="@string/scan_success_vibrate" />
            <View style="@style/SettingsDivider" />
            <Switch android:id="@+id/sw_scan_sound" style="@style/SettingsModernSwitch" android:text="@string/scan_success_sound" />
            <View style="@style/SettingsDivider" />
            <Switch android:id="@+id/sw_scan_auto_copy" style="@style/SettingsModernSwitch" android:text="@string/scan_auto_copy" />
            <View style="@style/SettingsDivider" />
            <Switch android:id="@+id/sw_album_auto_save" style="@style/SettingsModernSwitch" android:text="@string/album_auto_save" />
            <View style="@style/SettingsDivider" />
            <Switch android:id="@+id/sw_continuous_scan" style="@style/SettingsModernSwitch" android:text="@string/continuous_scan_mode" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card_teal"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/SettingsSectionHeader">
                <ImageView
                    style="@style/SettingsSectionIcon"
                    android:background="@drawable/bg_settings_icon_teal"
                    android:src="@drawable/ic_quick_access_sparkle"
                    android:tint="@color/settings_teal" />
                <TextView
                    style="@style/SettingsSectionTitle"
                    android:text="@string/general" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_quick_access"
                style="@style/SettingsModernSwitch"
                android:layout_marginTop="12dp"
                android:text="@string/quick_access_enable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/quick_access_enable_summary"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/quick_access_icon_style"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <RadioGroup
                    android:id="@+id/rg_quick_access_icon_style"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="0dp">
                    <RadioButton
                        android:id="@+id/rb_quick_access_sparkle"
                        style="@style/SettingsOrbOption"
                        android:contentDescription="@string/quick_access_style_sparkle"
                        android:drawableTop="@drawable/ic_quick_access_sparkle_preview" />
                    <RadioButton
                        android:id="@+id/rb_quick_access_ks"
                        style="@style/SettingsOrbOption"
                        android:contentDescription="@string/quick_access_style_ks"
                        android:drawableTop="@drawable/ic_quick_access_ks_preview" />
                    <RadioButton
                        android:id="@+id/rb_quick_access_key"
                        style="@style/SettingsOrbOption"
                        android:layout_marginEnd="0dp"
                        android:contentDescription="@string/quick_access_style_key"
                        android:drawableTop="@drawable/ic_quick_access_key_preview" />
                </RadioGroup>
            </LinearLayout>

            <TextView style="@style/SettingsFeatureLabel" android:text="@string/theme_mode" />
            <Spinner android:id="@+id/sp_theme_mode" style="@style/SettingsModernSpinner" />
            <TextView style="@style/SettingsFeatureLabel" android:layout_marginTop="12dp" android:text="@string/default_page" />
            <Spinner android:id="@+id/sp_default_page" style="@style/SettingsModernSpinner" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
