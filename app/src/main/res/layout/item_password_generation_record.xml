<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_history_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_history_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_icon_action"
        android:contentDescription="@string/credential_show_password_desc"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_visibility_off_24"
        android:tint="@color/action_icon_tint" />

    <ImageButton
        android:id="@+id/btn_history_copy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_action"
        android:contentDescription="@string/copy"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_content_copy_24"
        android:tint="@color/action_icon_tint" />

    <ImageButton
        android:id="@+id/btn_history_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_action"
        android:contentDescription="@string/action_edit"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_edit_24"
        android:tint="@color/action_icon_tint" />

</LinearLayout>


