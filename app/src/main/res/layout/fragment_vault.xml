<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_light" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_vault_home" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="@string/vault_home" android:src="@drawable/ic_home_24" android:tint="@color/text_main"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/vault_title" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/btn_vault_menu" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="@string/vault_menu" android:src="@drawable/ic_more_vert_24" android:tint="@color/text_main"/>
    </LinearLayout>
    <SearchView android:id="@+id/search_vault" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edit_text" android:queryHint="@string/vault_search_hint" android:iconifiedByDefault="false"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_vault" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp"/>
    <Button android:id="@+id/btn_vault_add" android:layout_width="match_parent" android:layout_height="50dp" android:text="@string/vault_add"/>
</LinearLayout>
