<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
    <ImageView android:id="@+id/iv_vault_record_icon" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="12dp" android:padding="9dp" android:src="@drawable/ic_key_line" android:tint="@color/action_icon_tint"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_vault_record_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_vault_record_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:singleLine="true" android:textColor="@color/text_secondary" android:textSize="11sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/iv_vault_record_favorite" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:src="@drawable/ic_star_border" android:tint="@color/text_secondary"/>
</LinearLayout>
