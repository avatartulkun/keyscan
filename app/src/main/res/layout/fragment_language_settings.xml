<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/settings_page_background" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_language_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_settings_home" android:contentDescription="@string/back" android:padding="10dp" android:src="@drawable/ic_arrow_back_24" android:tint="@color/settings_blue" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/language" android:textColor="@color/text_main" android:textSize="24sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_language_compact_card" android:orientation="vertical">
        <LinearLayout android:id="@+id/card_application_language" android:layout_width="match_parent" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="10dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_settings_icon_blue" android:padding="7dp" android:src="@drawable/ic_language_globe" android:tint="@color/settings_blue" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:text="@string/language_setting" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_current_application_language" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxWidth="115dp" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <ImageView android:id="@+id/language_expand_arrow" android:layout_width="28dp" android:layout_height="match_parent" android:contentDescription="@null" android:padding="4dp" android:src="@drawable/ic_chevron_down_24" />
        </LinearLayout>
        <LinearLayout android:id="@+id/language_list_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
