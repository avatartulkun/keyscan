<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
    <ImageView android:id="@+id/iv_choice_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="13dp" android:padding="5dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_choice_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_choice_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:singleLine="true" android:textColor="@color/text_secondary" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="end" android:text="›" android:textColor="@color/text_secondary" android:textSize="21sp"/>
</LinearLayout>
