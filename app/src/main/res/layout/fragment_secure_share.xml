<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btn_secure_share_home"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/vault_home"
            android:src="@drawable/ic_home_24"
            android:tint="@color/text_main" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/secure_share_title"
            android:textColor="@color/text_main"
            android:textSize="21sp"
            android:textStyle="bold" />
        <Space android:layout_width="44dp" android:layout_height="44dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/secure_share_page_summary"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/secure_share_direct_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:text="@string/secure_share_direct_password_selected"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/card_secure_share_send"
        style="@style/SmartScanCard"
        android:layout_marginTop="24dp">
        <ImageView
            style="@style/SmartScanIcon"
            android:background="@drawable/bg_tool_icon_cyan"
            android:src="@drawable/ic_primary_share"
            android:tint="@color/vault_icon_cyan" />
        <LinearLayout style="@style/SmartScanText">
            <TextView style="@style/SmartScanTitle" android:text="@string/secure_share_send_title" />
            <TextView style="@style/SmartScanSubtitle" android:text="@string/secure_share_send_summary" />
        </LinearLayout>
        <TextView style="@style/SmartScanArrow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_secure_share_receive"
        style="@style/SmartScanCard">
        <ImageView
            style="@style/SmartScanIcon"
            android:background="@drawable/bg_tool_icon_green"
            android:src="@drawable/ic_qr"
            android:tint="@color/vault_icon_green" />
        <LinearLayout style="@style/SmartScanText">
            <TextView style="@style/SmartScanTitle" android:text="@string/secure_share_receive_title" />
            <TextView style="@style/SmartScanSubtitle" android:text="@string/secure_share_receive_summary" />
        </LinearLayout>
        <TextView style="@style/SmartScanArrow" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/secure_share_steps"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
