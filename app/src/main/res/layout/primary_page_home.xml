<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/primary_page_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp" android:paddingBottom="20dp">

        <FrameLayout android:id="@+id/primary_core_stack" android:layout_width="match_parent" android:layout_height="320dp" android:clickable="true" android:focusable="true" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/primary_core_otp" style="@style/PrimaryCoreCard" android:layout_marginStart="6dp" android:layout_marginTop="8dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_primary_core_otp" android:elevation="3dp">
                <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_core_icon" android:elevation="4dp" android:padding="11dp" android:src="@drawable/ic_shield" android:tint="#246FD9" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_otp" android:textColor="@android:color/white" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:id="@+id/primary_core_otp_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#E7F2FF" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/primary_core_vault" style="@style/PrimaryCoreCard" android:layout_marginStart="6dp" android:layout_marginTop="88dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_primary_core_vault" android:elevation="6dp">
                <ImageView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_primary_core_icon" android:elevation="4dp" android:padding="11dp" android:src="@drawable/ic_vault_wallet" android:tint="#079D91" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_password_notes" android:textColor="@android:color/white" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:id="@+id/primary_core_vault_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#E7FFFC" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/primary_core_password" style="@style/PrimaryCoreCard" android:layout_marginStart="6dp" android:layout_marginTop="168dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_primary_core_password" android:elevation="10dp">
                <ImageView android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_primary_icon_blue" android:elevation="6dp" android:padding="12dp" android:src="@drawable/ic_book_key" android:tint="@android:color/white" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="17dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_password_forge" android:textColor="@android:color/white" android:textSize="21sp" android:textStyle="bold" />
                    <TextView android:id="@+id/primary_core_password_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#E7F0FF" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:gravity="center" android:text="@string/primary_core_swipe_hint" android:textColor="@color/primary_reference_title" android:textSize="14sp" />

        <LinearLayout android:id="@+id/primary_security_status_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_primary_entry" android:elevation="2dp" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="15dp" android:paddingEnd="18dp" android:paddingBottom="15dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/security_status_title" android:textColor="@color/primary_reference_title" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:id="@+id/primary_security_biometric_icon" android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="@null" android:src="@drawable/ic_security_fingerprint_24"/><TextView android:id="@+id/primary_security_biometric_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="14sp"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:id="@+id/primary_security_encryption_icon" android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="@null" android:src="@drawable/ic_security_lock_24"/><TextView android:id="@+id/primary_security_encryption_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="14sp"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:id="@+id/primary_security_duplicate_icon" android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="@null" android:src="@drawable/ic_security_warning_24"/><TextView android:id="@+id/primary_security_duplicate_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="14sp"/></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
