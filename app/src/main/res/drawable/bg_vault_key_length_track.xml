<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/settings_status_fill" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="7dp" android:bottom="7dp">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/primary_blue"
                    android:endColor="@color/accent" />
            </shape>
        </clip>
    </item>
</layer-list>
