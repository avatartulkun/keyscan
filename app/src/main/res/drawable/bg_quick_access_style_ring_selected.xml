<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#23C7FF"
                android:centerColor="#FF3F91"
                android:endColor="#FFA326"
                android:useLevel="false" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#F8FAFC" />
        </shape>
    </item>
</layer-list>
