<?xml version="1.0" encoding="utf-8"?><resources>
    <style name="SmartScanCard"><item name="android:layout_width">match_parent</item><item name="android:layout_height">96dp</item><item name="android:layout_marginBottom">14dp</item><item name="android:background">@drawable/bg_card</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item><item name="android:padding">16dp</item><item name="android:clickable">true</item><item name="android:focusable">true</item></style>
    <style name="SmartScanIcon"><item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item><item name="android:padding">9dp</item><item name="android:background">@drawable/bg_tool_icon_cyan</item><item name="android:tint">@color/primary</item></style>
    <style name="SmartScanText"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:layout_marginStart">14dp</item><item name="android:orientation">vertical</item></style>
    <style name="SmartScanTitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/text_main</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
    <style name="SmartScanSubtitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">5dp</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">13sp</item></style>
    <style name="SmartScanArrow"><item name="android:layout_width">24dp</item><item name="android:layout_height">wrap_content</item><item name="android:text">›</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">26sp</item></style>
</resources>
